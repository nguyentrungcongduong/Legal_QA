<mxfile host="app.diagrams.net">
  <diagram name="Hoi Dap Phap Luat">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- System Boundary -->
        <mxCell id="sys" value="Hỏi Đáp Pháp Luật — Hệ thống Legal QA" style="swimlane;startSize=30;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="120" y="20" width="1200" height="820" as="geometry" />
        </mxCell>

        <!-- Actor -->
        <mxCell id="user" value="User" style="shape=mxgraph.uml.actor;whiteSpace=wrap;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="25" y="360" width="50" height="80" as="geometry" />
        </mxCell>

        <!-- ===== MAIN USE CASE ===== -->
        <mxCell id="uc_ask" value="Đặt câu hỏi pháp luật" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="sys">
          <mxGeometry x="100" y="360" width="210" height="65" as="geometry" />
        </mxCell>

        <!-- ===== RAG PIPELINE (includes từ Đặt câu hỏi) ===== -->
        <mxCell id="uc_domain" value="Phân loại lĩnh vực pháp luật" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="sys">
          <mxGeometry x="430" y="80" width="210" height="60" as="geometry" />
        </mxCell>

        <mxCell id="uc_rewrite" value="Rewrite câu hỏi" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="sys">
          <mxGeometry x="430" y="200" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="uc_search" value="Tìm kiếm văn bản&#xa;(Hybrid Search + Rerank)" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="sys">
          <mxGeometry x="430" y="330" width="210" height="65" as="geometry" />
        </mxCell>

        <mxCell id="uc_conflict" value="Phát hiện xung đột pháp lý" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="sys">
          <mxGeometry x="760" y="250" width="210" height="60" as="geometry" />
        </mxCell>

        <mxCell id="uc_generate" value="Sinh câu trả lời có trích dẫn" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="sys">
          <mxGeometry x="430" y="480" width="210" height="60" as="geometry" />
        </mxCell>

        <mxCell id="uc_citation" value="Xem trích dẫn nguồn [1][2]" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="sys">
          <mxGeometry x="430" y="610" width="210" height="60" as="geometry" />
        </mxCell>

        <!-- ===== EXTEND USE CASES ===== -->
        <mxCell id="uc_followup" value="Hỏi tiếp / Yêu cầu&#xa;giải thích thêm (Multi-turn)" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="sys">
          <mxGeometry x="80" y="160" width="220" height="65" as="geometry" />
        </mxCell>

        <mxCell id="uc_pdf" value="Xem file PDF gốc" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="sys">
          <mxGeometry x="760" y="600" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- ===== ACTOR EDGES ===== -->
        <mxCell id="e_u1" style="endArrow=none;" edge="1" source="user" target="uc_ask" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_u2" style="endArrow=none;" edge="1" source="user" target="uc_followup" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== INCLUDE EDGES (Đặt câu hỏi → RAG pipeline) ===== -->
        <mxCell id="inc1" value="&lt;&lt;include&gt;&gt;" style="dashed=1;endArrow=open;endFill=0;" edge="1" source="uc_ask" target="uc_domain" parent="sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="inc2" value="&lt;&lt;include&gt;&gt;" style="dashed=1;endArrow=open;endFill=0;" edge="1" source="uc_ask" target="uc_rewrite" parent="sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="inc3" value="&lt;&lt;include&gt;&gt;" style="dashed=1;endArrow=open;endFill=0;" edge="1" source="uc_ask" target="uc_search" parent="sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="inc4" value="&lt;&lt;include&gt;&gt;" style="dashed=1;endArrow=open;endFill=0;" edge="1" source="uc_search" target="uc_conflict" parent="sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Sinh câu trả lời include từ Đặt câu hỏi (ĐÚNG) -->
        <mxCell id="inc5" value="&lt;&lt;include&gt;&gt;" style="dashed=1;endArrow=open;endFill=0;" edge="1" source="uc_ask" target="uc_generate" parent="sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Xem trích dẫn include từ Đặt câu hỏi (luôn hiển thị cùng câu trả lời) -->
        <mxCell id="inc6" value="&lt;&lt;include&gt;&gt;" style="dashed=1;endArrow=open;endFill=0;" edge="1" source="uc_ask" target="uc_citation" parent="sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== EXTEND EDGES ===== -->
        <!-- Multi-turn extend Đặt câu hỏi -->
        <mxCell id="ext1" value="&lt;&lt;extend&gt;&gt;" style="dashed=1;endArrow=open;endFill=0;" edge="1" source="uc_followup" target="uc_ask" parent="sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Xem PDF extend Xem trích dẫn (user chủ động click) -->
        <mxCell id="ext2" value="&lt;&lt;extend&gt;&gt;" style="dashed=1;endArrow=open;endFill=0;" edge="1" source="uc_pdf" target="uc_citation" parent="sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
