<mxfile host="app.diagrams.net">
  <diagram name="Activity - Multi-turn">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1350" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />

        <mxCell id="pool" value="2.4.5 Sơ đồ hoạt động — Hỏi Tiếp / Multi-turn Conversation" style="shape=pool;startSize=30;horizontal=1;childLayout=stackLayout;horizontalStack=1;resizeParent=1;resizeParentMax=0;collapsible=0;marginBottom=0;swimlaneHead=0;fillColor=none;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="1060" height="1300" as="geometry" />
        </mxCell>

        <mxCell id="lu" value="Người dùng" style="swimlane;startSize=30;horizontal=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="pool">
          <mxGeometry x="0" y="0" width="260" height="1300" as="geometry" />
        </mxCell>
        <mxCell id="lf" value="Frontend (Vue)" style="swimlane;startSize=30;horizontal=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="pool">
          <mxGeometry x="260" y="0" width="270" height="1300" as="geometry" />
        </mxCell>
        <mxCell id="lr" value="RAG Pipeline (FastAPI + Python)" style="swimlane;startSize=30;horizontal=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="pool">
          <mxGeometry x="530" y="0" width="270" height="1300" as="geometry" />
        </mxCell>
        <mxCell id="lb" value="Backend (PostgreSQL)" style="swimlane;startSize=30;horizontal=0;fillColor=#f8e6ff;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="pool">
          <mxGeometry x="800" y="0" width="200" height="1300" as="geometry" />
        </mxCell>

        <!-- START -->
        <mxCell id="start" value="" style="ellipse;fillColor=#000000;" vertex="1" parent="lu">
          <mxGeometry x="110" y="50" width="30" height="30" as="geometry" />
        </mxCell>

        <!-- User: Đọc câu trả lời trước -->
        <mxCell id="u0" value="Đọc câu trả lời từ lượt trước" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lu">
          <mxGeometry x="30" y="110" width="195" height="45" as="geometry" />
        </mxCell>

        <!-- User: Nhập câu hỏi tiếp -->
        <mxCell id="u1" value="Nhập câu hỏi tiếp theo&#xa;(hỏi thêm / giải thích thêm)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lu">
          <mxGeometry x="30" y="190" width="195" height="55" as="geometry" />
        </mxCell>

        <!-- Frontend: Build chat_history -->
        <mxCell id="f1" value="Lấy chat_history&#xa;(tối đa 4 lượt gần nhất)&#xa;Append câu hỏi mới" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lf">
          <mxGeometry x="35" y="190" width="200" height="70" as="geometry" />
        </mxCell>

        <!-- Frontend: Send -->
        <mxCell id="f2" value="POST /api/chat&#xa;{question, chat_history, session_id}" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lf">
          <mxGeometry x="35" y="295" width="200" height="55" as="geometry" />
        </mxCell>

        <!-- RAG: Guard -->
        <mxCell id="d_guard" value="Câu hỏi thuộc&#xa;lĩnh vực pháp luật?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="lr">
          <mxGeometry x="45" y="295" width="180" height="75" as="geometry" />
        </mxCell>

        <!-- RAG: Reject -->
        <mxCell id="r_rej" value="Từ chối:&#xa;&quot;Ngoài phạm vi tư vấn&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="lr">
          <mxGeometry x="45" y="410" width="180" height="45" as="geometry" />
        </mxCell>

        <!-- RAG: Decision domain inherit -->
        <mxCell id="d_domain" value="Cùng domain&#xa;với lượt trước?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="lr">
          <mxGeometry x="45" y="490" width="180" height="75" as="geometry" />
        </mxCell>

        <!-- RAG: Kế thừa domain -->
        <mxCell id="r_inherit" value="Kế thừa domain&#xa;từ lượt trước&#xa;(không phân loại lại)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="lr">
          <mxGeometry x="45" y="605" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- RAG: Phân loại mới -->
        <mxCell id="r_newdomain" value="Phân loại domain mới" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lr">
          <mxGeometry x="45" y="700" width="180" height="45" as="geometry" />
        </mxCell>

        <!-- RAG: Rewrite với context -->
        <mxCell id="r1" value="Rewrite câu hỏi&#xa;(Có ngữ cảnh chat_history)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lr">
          <mxGeometry x="45" y="780" width="180" height="55" as="geometry" />
        </mxCell>

        <!-- RAG: Hybrid Search + Rerank -->
        <mxCell id="r2" value="Hybrid Search + Rerank&#xa;(tìm chunks liên quan)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lr">
          <mxGeometry x="45" y="865" width="180" height="55" as="geometry" />
        </mxCell>

        <!-- RAG: Generate với chat_history -->
        <mxCell id="r3" value="Generate: LLM hiểu ngữ cảnh&#xa;từ chat_history&#xa;Sinh câu trả lời [N]" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lr">
          <mxGeometry x="45" y="950" width="180" height="65" as="geometry" />
        </mxCell>

        <!-- DB: Lưu turn mới -->
        <mxCell id="b1" value="Lưu turn mới vào DB&#xa;(session_id, Q&amp;A, timestamp)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lb">
          <mxGeometry x="25" y="950" width="155" height="60" as="geometry" />
        </mxCell>

        <!-- Frontend: Append answer -->
        <mxCell id="f3" value="Append câu trả lời mới&#xa;vào luồng chat&#xa;Cập nhật chat_history" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lf">
          <mxGeometry x="35" y="1060" width="200" height="65" as="geometry" />
        </mxCell>

        <!-- User: Read new answer -->
        <mxCell id="u2" value="Đọc câu trả lời mới" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lu">
          <mxGeometry x="30" y="1060" width="195" height="50" as="geometry" />
        </mxCell>

        <!-- Decision: Continue? -->
        <mxCell id="d_cont" value="Hỏi tiếp&#xa;hay kết thúc?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="lu">
          <mxGeometry x="65" y="1145" width="140" height="75" as="geometry" />
        </mxCell>

        <!-- END -->
        <mxCell id="end" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;double=1;" vertex="1" parent="lu">
          <mxGeometry x="110" y="1250" width="30" height="30" as="geometry" />
        </mxCell>

        <!-- ===== EDGES ===== -->
        <mxCell id="es" style="endArrow=block;endFill=1;" edge="1" source="start" target="u0" parent="lu"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eu0" style="endArrow=block;endFill=1;" edge="1" source="u0" target="u1" parent="lu"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eu2_d" style="endArrow=block;endFill=1;" edge="1" source="u2" target="d_cont" parent="lu"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ed_loop" value="Hỏi tiếp" style="endArrow=block;endFill=1;" edge="1" source="d_cont" target="u1" parent="lu">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="240" y="1182"/><mxPoint x="240" y="217"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="ed_end" value="Kết thúc" style="endArrow=block;endFill=1;" edge="1" source="d_cont" target="end" parent="lu"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Frontend edges -->
        <mxCell id="ef1_f2" style="endArrow=block;endFill=1;" edge="1" source="f1" target="f2" parent="lf"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- RAG edges -->
        <mxCell id="er_no" value="Không" style="endArrow=block;endFill=1;" edge="1" source="d_guard" target="r_rej" parent="lr"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="er_yes" value="Có" style="endArrow=block;endFill=1;" edge="1" source="d_guard" target="d_domain" parent="lr"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="er_same" value="Có" style="endArrow=block;endFill=1;" edge="1" source="d_domain" target="r_inherit" parent="lr"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="er_diff" value="Không" style="endArrow=block;endFill=1;" edge="1" source="d_domain" target="r_newdomain" parent="lr"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="er_inh_r1" style="endArrow=block;endFill=1;" edge="1" source="r_inherit" target="r1" parent="lr"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="er_new_r1" style="endArrow=block;endFill=1;" edge="1" source="r_newdomain" target="r1" parent="lr"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="er1_r2" style="endArrow=block;endFill=1;" edge="1" source="r1" target="r2" parent="lr"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="er2_r3" style="endArrow=block;endFill=1;" edge="1" source="r2" target="r3" parent="lr"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Cross-lane -->
        <mxCell id="cx1" style="endArrow=block;endFill=1;dashed=1;" edge="1" source="u1" target="f1" parent="pool"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="cx2" style="endArrow=block;endFill=1;dashed=1;" edge="1" source="f2" target="d_guard" parent="pool"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="cx3" style="endArrow=block;endFill=1;dashed=1;" edge="1" source="r3" target="b1" parent="pool"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="cx4" style="endArrow=block;endFill=1;dashed=1;" edge="1" source="r3" target="f3" parent="pool"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="cx5" style="endArrow=block;endFill=1;dashed=1;" edge="1" source="f3" target="u2" parent="pool"><mxGeometry relative="1" as="geometry"/></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
