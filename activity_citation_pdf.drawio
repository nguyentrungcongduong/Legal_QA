<mxfile host="app.diagrams.net">
  <diagram name="Activity - Trich Dan PDF">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1350" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- POOL -->
        <mxCell id="pool" value="2.4.4 Sơ đồ hoạt động — Xem Trích Dẫn &amp; Tài Liệu PDF Gốc" style="shape=pool;startSize=30;horizontal=1;childLayout=stackLayout;horizontalStack=1;resizeParent=1;resizeParentMax=0;collapsible=0;marginBottom=0;swimlaneHead=0;fillColor=none;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="1060" height="1290" as="geometry" />
        </mxCell>

        <!-- Lane: User -->
        <mxCell id="lu" value="Người dùng" style="swimlane;startSize=30;horizontal=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="pool">
          <mxGeometry x="0" y="0" width="270" height="1290" as="geometry" />
        </mxCell>

        <!-- Lane: Frontend (Vue + ChatView) -->
        <mxCell id="lf" value="Frontend (Vue + ChatView)" style="swimlane;startSize=30;horizontal=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="pool">
          <mxGeometry x="270" y="0" width="290" height="1290" as="geometry" />
        </mxCell>

        <!-- Lane: Backend (File Server) -->
        <mxCell id="lb" value="Backend (File Server)" style="swimlane;startSize=30;horizontal=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="pool">
          <mxGeometry x="560" y="0" width="280" height="1290" as="geometry" />
        </mxCell>

        <!-- Lane: PDF Drawer UI -->
        <mxCell id="ld" value="PDF Drawer (UI Component)" style="swimlane;startSize=30;horizontal=0;fillColor=#f8e6ff;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="pool">
          <mxGeometry x="840" y="0" width="220" height="1290" as="geometry" />
        </mxCell>

        <!-- ===== NODES ===== -->

        <!-- START -->
        <mxCell id="start" value="" style="ellipse;fillColor=#000000;" vertex="1" parent="lu">
          <mxGeometry x="115" y="50" width="30" height="30" as="geometry" />
        </mxCell>

        <!-- User: Đọc câu trả lời -->
        <mxCell id="u1" value="Đọc câu trả lời&#xa;có [1][2]... màu vàng" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lu">
          <mxGeometry x="35" y="110" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- Decision: Click how? -->
        <mxCell id="d1" value="Chọn xem&#xa;trích dẫn bằng cách nào?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="lu">
          <mxGeometry x="60" y="195" width="155" height="85" as="geometry" />
        </mxCell>

        <!-- A: Click [N] in text -->
        <mxCell id="u2a" value="Click số [N]&#xa;trong câu trả lời" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lu">
          <mxGeometry x="10" y="320" width="170" height="50" as="geometry" />
        </mxCell>

        <!-- B: Click source in list -->
        <mxCell id="u2b" value="Click tên văn bản&#xa;trong danh sách citations" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lu">
          <mxGeometry x="10" y="400" width="170" height="50" as="geometry" />
        </mxCell>

        <!-- Frontend: Handle click -->
        <mxCell id="f1" value="Xác định citation[N]&#xa;từ mảng citations[]&#xa;(tên NĐ, điều, khoản, trang, file_path)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lf">
          <mxGeometry x="45" y="480" width="200" height="70" as="geometry" />
        </mxCell>

        <!-- Frontend: Open drawer -->
        <mxCell id="f2" value="Mở PDF Drawer&#xa;(trượt từ phải sang trái)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lf">
          <mxGeometry x="45" y="585" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- Frontend: Render metadata -->
        <mxCell id="f3" value="Render cột trái:&#xa;- Tên văn bản&#xa;- Điều, Khoản&#xa;- Relevance score&#xa;- Nội dung đoạn trích" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lf">
          <mxGeometry x="45" y="665" width="200" height="90" as="geometry" />
        </mxCell>

        <!-- Backend: Serve PDF -->
        <mxCell id="b1" value="GET /api/documents/{file_path}&#xa;Trả về file PDF" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lb">
          <mxGeometry x="40" y="665" width="200" height="55" as="geometry" />
        </mxCell>

        <!-- Decision: PDF found? -->
        <mxCell id="d_pdf" value="File PDF&#xa;tồn tại?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="lb">
          <mxGeometry x="65" y="755" width="140" height="70" as="geometry" />
        </mxCell>

        <!-- Error: PDF not found -->
        <mxCell id="b_err" value="Trả về lỗi:&#xa;&quot;Không tải được file PDF&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="lb">
          <mxGeometry x="40" y="860" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- Drawer: PDF Viewer -->
        <mxCell id="d1_render" value="Hiển thị PDF Viewer&#xa;(iframe embed)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="ld">
          <mxGeometry x="25" y="755" width="170" height="50" as="geometry" />
        </mxCell>

        <!-- Drawer: Navigate to page -->
        <mxCell id="d2_nav" value="Điều hướng đến trang&#xa;page_number = {page}" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="ld">
          <mxGeometry x="25" y="835" width="170" height="50" as="geometry" />
        </mxCell>

        <!-- User: Read PDF -->
        <mxCell id="u3" value="Đọc nội dung&#xa;PDF gốc" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lu">
          <mxGeometry x="35" y="900" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- Decision: Next action -->
        <mxCell id="d_next" value="Hành động&#xa;tiếp theo?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="lu">
          <mxGeometry x="65" y="985" width="145" height="80" as="geometry" />
        </mxCell>

        <!-- Option A: View another citation -->
        <mxCell id="u4a" value="Click trích dẫn khác [M]" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lu">
          <mxGeometry x="10" y="1100" width="170" height="45" as="geometry" />
        </mxCell>

        <!-- Option B: Close drawer -->
        <mxCell id="u4b" value="Đóng Drawer (nhấn ✕&#xa;hoặc click ngoài)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lu">
          <mxGeometry x="10" y="1175" width="170" height="50" as="geometry" />
        </mxCell>

        <!-- Frontend: Close drawer -->
        <mxCell id="f4" value="Đóng PDF Drawer&#xa;Trở về giao diện chat" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lf">
          <mxGeometry x="45" y="1175" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- END -->
        <mxCell id="end" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;double=1;" vertex="1" parent="lu">
          <mxGeometry x="115" y="1250" width="30" height="30" as="geometry" />
        </mxCell>

        <!-- ===== EDGES USER LANE ===== -->
        <mxCell id="es" style="endArrow=block;endFill=1;" edge="1" source="start" target="u1" parent="lu"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eu1_d1" style="endArrow=block;endFill=1;" edge="1" source="u1" target="d1" parent="lu"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ed1_a" value="Click [N]" style="endArrow=block;endFill=1;" edge="1" source="d1" target="u2a" parent="lu"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ed1_b" value="Click tên" style="endArrow=block;endFill=1;" edge="1" source="d1" target="u2b" parent="lu"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eu3_next" style="endArrow=block;endFill=1;" edge="1" source="u3" target="d_next" parent="lu"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ed_next_a" value="Xem thêm" style="endArrow=block;endFill=1;" edge="1" source="d_next" target="u4a" parent="lu"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ed_next_b" value="Đóng" style="endArrow=block;endFill=1;" edge="1" source="d_next" target="u4b" parent="lu"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eu4a_loop" style="endArrow=block;endFill=1;" edge="1" source="u4a" target="d1" parent="lu">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="245" y="1122"/><mxPoint x="245" y="237"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="eu4b_end" style="endArrow=block;endFill=1;" edge="1" source="u4b" target="end" parent="lu"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- EDGES FRONTEND LANE -->
        <mxCell id="ef2_f3" style="endArrow=block;endFill=1;" edge="1" source="f2" target="f3" parent="lf"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- EDGES BACKEND LANE -->
        <mxCell id="eb_yes" value="Có" style="endArrow=block;endFill=1;" edge="1" source="d_pdf" target="d1_render" parent="pool"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eb_no" value="Không" style="endArrow=block;endFill=1;" edge="1" source="d_pdf" target="b_err" parent="lb"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- EDGES DRAWER LANE -->
        <mxCell id="ed1_d2" style="endArrow=block;endFill=1;" edge="1" source="d1_render" target="d2_nav" parent="ld"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- CROSS-LANE EDGES -->
        <mxCell id="cx1a" style="endArrow=block;endFill=1;dashed=1;" edge="1" source="u2a" target="f1" parent="pool"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="cx1b" style="endArrow=block;endFill=1;dashed=1;" edge="1" source="u2b" target="f1" parent="pool"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="cx2" style="endArrow=block;endFill=1;dashed=1;" edge="1" source="f1" target="f2" parent="pool"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="cx3" style="endArrow=block;endFill=1;dashed=1;" edge="1" source="f3" target="b1" parent="pool"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="cx4" style="endArrow=block;endFill=1;dashed=1;" edge="1" source="b1" target="d_pdf" parent="pool"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="cx5" style="endArrow=block;endFill=1;dashed=1;" edge="1" source="d2_nav" target="u3" parent="pool"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="cx6" style="endArrow=block;endFill=1;dashed=1;" edge="1" source="u4b" target="f4" parent="pool"><mxGeometry relative="1" as="geometry"/></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
