<mxfile host="app.diagrams.net">
  <diagram name="Landing Page Use Case">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- System Boundary -->
        <mxCell id="sys" value="Trang Giới Thiệu Hệ Thống (Landing Page) — Legal QA RAG" style="swimlane;startSize=30;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="120" y="30" width="900" height="680" as="geometry" />
        </mxCell>

        <!-- Actor: Guest -->
        <mxCell id="guest" value="Guest" style="shape=mxgraph.uml.actor;whiteSpace=wrap;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="25" y="300" width="50" height="80" as="geometry" />
        </mxCell>

        <!-- ===== USE CASES ===== -->

        <!-- Main UC -->
        <mxCell id="uc_view" value="Xem trang giới thiệu hệ thống" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="sys">
          <mxGeometry x="130" y="300" width="230" height="65" as="geometry" />
        </mxCell>

        <!-- Sub UCs (includes) -->
        <mxCell id="uc_pipeline" value="Xem giới thiệu RAG Pipeline 7 tầng" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="sys">
          <mxGeometry x="460" y="120" width="230" height="65" as="geometry" />
        </mxCell>

        <mxCell id="uc_domain" value="Xem 5 lĩnh vực pháp luật" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="sys">
          <mxGeometry x="460" y="260" width="215" height="65" as="geometry" />
        </mxCell>

        <mxCell id="uc_stats" value="Xem thống kê hệ thống&#xa;(Faithfulness, tốc độ phản hồi...)" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="sys">
          <mxGeometry x="460" y="400" width="230" height="65" as="geometry" />
        </mxCell>

        <!-- Extend UCs -->
        <mxCell id="uc_goto_login" value="Nhấn &quot;Bắt đầu tư vấn&quot;&#xa;→ Chuyển đến Đăng nhập" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="sys">
          <mxGeometry x="130" y="100" width="230" height="65" as="geometry" />
        </mxCell>

        <mxCell id="uc_goto_register" value="Nhấn &quot;Tạo tài khoản&quot;&#xa;→ Chuyển đến Đăng ký" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="sys">
          <mxGeometry x="130" y="510" width="230" height="65" as="geometry" />
        </mxCell>

        <!-- ===== EDGES ===== -->

        <!-- Guest → main UCs -->
        <mxCell id="e1" style="endArrow=none;" edge="1" source="guest" target="uc_view" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="endArrow=none;" edge="1" source="guest" target="uc_goto_login" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="endArrow=none;" edge="1" source="guest" target="uc_goto_register" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Xem trang giới thiệu <<include>> sub UCs -->
        <mxCell id="inc1" value="&lt;&lt;include&gt;&gt;" style="dashed=1;endArrow=open;endFill=0;startArrow=none;" edge="1" source="uc_view" target="uc_pipeline" parent="sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="inc2" value="&lt;&lt;include&gt;&gt;" style="dashed=1;endArrow=open;endFill=0;startArrow=none;" edge="1" source="uc_view" target="uc_domain" parent="sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="inc3" value="&lt;&lt;include&gt;&gt;" style="dashed=1;endArrow=open;endFill=0;startArrow=none;" edge="1" source="uc_view" target="uc_stats" parent="sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- extend: click CTA -->
        <mxCell id="ext1" value="&lt;&lt;extend&gt;&gt;" style="dashed=1;endArrow=open;endFill=0;startArrow=none;" edge="1" source="uc_goto_login" target="uc_view" parent="sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ext2" value="&lt;&lt;extend&gt;&gt;" style="dashed=1;endArrow=open;endFill=0;startArrow=none;" edge="1" source="uc_goto_register" target="uc_view" parent="sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
