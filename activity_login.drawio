<mxfile host="app.diagrams.net">
  <diagram name="Activity - Dang Nhap">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1380" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- SWIM LANE POOL -->
        <mxCell id="pool" value="2.4.2 Sơ đồ hoạt động — Đăng nhập" style="shape=pool;startSize=30;horizontal=1;childLayout=stackLayout;horizontalStack=1;resizeParent=1;resizeParentMax=0;collapsible=0;marginBottom=0;swimlaneHead=0;fillColor=none;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1040" height="1320" as="geometry" />
        </mxCell>

        <!-- Lane: User -->
        <mxCell id="lu" value="Người dùng (Client)" style="swimlane;startSize=30;horizontal=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="pool">
          <mxGeometry x="0" y="0" width="310" height="1320" as="geometry" />
        </mxCell>

        <!-- Lane: Frontend Vue -->
        <mxCell id="lf" value="Frontend (Vue + Router Guard)" style="swimlane;startSize=30;horizontal=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="pool">
          <mxGeometry x="310" y="0" width="320" height="1320" as="geometry" />
        </mxCell>

        <!-- Lane: Backend Spring Boot -->
        <mxCell id="lb" value="Backend (Spring Boot Auth)" style="swimlane;startSize=30;horizontal=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="pool">
          <mxGeometry x="630" y="0" width="310" height="1320" as="geometry" />
        </mxCell>

        <!-- ===== NODES ===== -->

        <!-- START -->
        <mxCell id="start" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="lu">
          <mxGeometry x="135" y="50" width="30" height="30" as="geometry" />
        </mxCell>

        <!-- 1. Truy cập /login -->
        <mxCell id="u1" value="Truy cập trang /login&#xa;(hoặc redirect từ trang bảo vệ)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lu">
          <mxGeometry x="55" y="110" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- Frontend: Check token -->
        <mxCell id="d_token" value="Token hợp lệ&#xa;trong localStorage?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="lf">
          <mxGeometry x="85" y="100" width="150" height="80" as="geometry" />
        </mxCell>

        <!-- Already logged in → redirect -->
        <mxCell id="f_redirect_auto" value="Tự động redirect&#xa;về /chat" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="lf">
          <mxGeometry x="85" y="220" width="170" height="45" as="geometry" />
        </mxCell>

        <!-- Display login form -->
        <mxCell id="f1" value="Hiển thị form đăng nhập&#xa;(Email, Mật khẩu)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lf">
          <mxGeometry x="85" y="310" width="170" height="50" as="geometry" />
        </mxCell>

        <!-- User: fill form -->
        <mxCell id="u2" value="Nhập Email và Mật khẩu&#xa;nhấn &quot;Đăng nhập&quot;" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lu">
          <mxGeometry x="55" y="330" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- Frontend validate: fields filled? -->
        <mxCell id="d1" value="Đầy đủ&#xa;thông tin?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="lf">
          <mxGeometry x="95" y="420" width="130" height="70" as="geometry" />
        </mxCell>

        <!-- Error: empty fields -->
        <mxCell id="f_err1" value="Hiển thị lỗi:&#xa;&quot;Vui lòng điền đầy đủ&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="lf">
          <mxGeometry x="85" y="530" width="175" height="45" as="geometry" />
        </mxCell>

        <!-- Send request -->
        <mxCell id="f2" value="Gửi POST /api/auth/login&#xa;{email, password}" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lf">
          <mxGeometry x="85" y="620" width="175" height="50" as="geometry" />
        </mxCell>

        <!-- Backend: Check email -->
        <mxCell id="d_email" value="Email tồn tại&#xa;trong DB?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="lb">
          <mxGeometry x="80" y="620" width="140" height="70" as="geometry" />
        </mxCell>

        <!-- Error: 404 -->
        <mxCell id="b_err1" value="Trả về 404&#xa;&quot;Tài khoản không tồn tại&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="lb">
          <mxGeometry x="65" y="730" width="180" height="50" as="geometry" />
        </mxCell>

        <!-- Backend: BCrypt verify -->
        <mxCell id="d_pwd" value="Mật khẩu&#xa;chính xác?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="lb">
          <mxGeometry x="80" y="830" width="140" height="70" as="geometry" />
        </mxCell>

        <!-- Error: 401 -->
        <mxCell id="b_err2" value="Trả về 401&#xa;&quot;Sai mật khẩu&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="lb">
          <mxGeometry x="65" y="940" width="180" height="45" as="geometry" />
        </mxCell>

        <!-- Backend: Generate JWT -->
        <mxCell id="b1" value="Tạo JWT Token (HS256, 24h)&#xa;Trả về cho Client" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lb">
          <mxGeometry x="65" y="1040" width="180" height="50" as="geometry" />
        </mxCell>

        <!-- Frontend: Save token -->
        <mxCell id="f3" value="Lưu JWT vào localStorage&#xa;Cập nhật authStore&#xa;(userId, username, role)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lf">
          <mxGeometry x="85" y="1040" width="175" height="60" as="geometry" />
        </mxCell>

        <!-- Frontend: Router guard -->
        <mxCell id="f4" value="Router Guard xác nhận&#xa;isAuthenticated = true" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lf">
          <mxGeometry x="85" y="1150" width="175" height="50" as="geometry" />
        </mxCell>

        <!-- User: redirect /chat -->
        <mxCell id="u3" value="Chuyển hướng về /chat&#xa;(Trang hỏi đáp pháp luật)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lu">
          <mxGeometry x="55" y="1170" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- END -->
        <mxCell id="end" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;double=1;" vertex="1" parent="lu">
          <mxGeometry x="135" y="1260" width="30" height="30" as="geometry" />
        </mxCell>

        <!-- ===== EDGES IN USER LANE ===== -->
        <mxCell id="e_s" style="endArrow=block;endFill=1;" edge="1" source="start" target="u1" parent="lu"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_u3_end" style="endArrow=block;endFill=1;" edge="1" source="u3" target="end" parent="lu"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- EDGES IN FRONTEND LANE -->
        <mxCell id="e_dt_yes" value="Có" style="endArrow=block;endFill=1;" edge="1" source="d_token" target="f_redirect_auto" parent="lf"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_dt_no" value="Không" style="endArrow=block;endFill=1;" edge="1" source="d_token" target="f1" parent="lf"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_f1_d1" style="endArrow=block;endFill=1;" edge="1" source="d1" target="f_err1" parent="lf">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_err1_d1" value="Không" style="endArrow=block;endFill=1;" edge="1" source="f_err1" target="d1" parent="lf">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="270" y="552"/><mxPoint x="270" y="455"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e_d1_f2" value="Có" style="endArrow=block;endFill=1;" edge="1" source="d1" target="f2" parent="lf"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_f3_f4" style="endArrow=block;endFill=1;" edge="1" source="f3" target="f4" parent="lf"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- EDGES IN BACKEND LANE -->
        <mxCell id="e_de_no" value="Không" style="endArrow=block;endFill=1;" edge="1" source="d_email" target="b_err1" parent="lb"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_de_yes" value="Có" style="endArrow=block;endFill=1;" edge="1" source="d_email" target="d_pwd" parent="lb"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_dp_no" value="Không" style="endArrow=block;endFill=1;" edge="1" source="d_pwd" target="b_err2" parent="lb"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_dp_yes" value="Có" style="endArrow=block;endFill=1;" edge="1" source="d_pwd" target="b1" parent="lb"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- CROSS-LANE EDGES -->
        <mxCell id="cx1" style="endArrow=block;endFill=1;dashed=1;" edge="1" source="u1" target="d_token" parent="pool"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="cx2" style="endArrow=block;endFill=1;dashed=1;" edge="1" source="u2" target="d1" parent="pool"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="cx3" style="endArrow=block;endFill=1;dashed=1;" edge="1" source="f2" target="d_email" parent="pool"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="cx4" style="endArrow=block;endFill=1;dashed=1;" edge="1" source="b1" target="f3" parent="pool"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="cx5" style="endArrow=block;endFill=1;dashed=1;" edge="1" source="f4" target="u3" parent="pool"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="cx_err1" style="endArrow=block;endFill=1;dashed=1;" edge="1" source="b_err1" target="f_err1" parent="pool"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="cx_err2" style="endArrow=block;endFill=1;dashed=1;" edge="1" source="b_err2" target="f_err1" parent="pool"><mxGeometry relative="1" as="geometry"/></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
