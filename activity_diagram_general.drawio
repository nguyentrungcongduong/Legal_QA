<mxfile host="app.diagrams.net">
  <diagram name="Activity Diagram Tong Quat">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===== SWIM LANES ===== -->
        <mxCell id="pool" value="Hệ thống Legal QA RAG — Sơ đồ hoạt động tổng quát" style="shape=pool;startSize=30;horizontal=1;childLayout=stackLayout;horizontalStack=1;resizeParent=1;resizeParentMax=0;collapsible=0;marginBottom=0;swimlaneHead=0;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1340" height="1720" as="geometry" />
        </mxCell>

        <!-- Lane: Guest/User -->
        <mxCell id="lane_user" value="Guest / User" style="swimlane;startSize=30;horizontal=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="pool">
          <mxGeometry x="0" y="0" width="340" height="1720" as="geometry" />
        </mxCell>

        <!-- Lane: System (Vue + Spring Boot) -->
        <mxCell id="lane_system" value="Hệ thống (Vue + Spring Boot)" style="swimlane;startSize=30;horizontal=0;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="pool">
          <mxGeometry x="340" y="0" width="360" height="1720" as="geometry" />
        </mxCell>

        <!-- Lane: RAG Pipeline (FastAPI + Python) -->
        <mxCell id="lane_rag" value="RAG Pipeline (FastAPI + Python)" style="swimlane;startSize=30;horizontal=0;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="pool">
          <mxGeometry x="700" y="0" width="340" height="1720" as="geometry" />
        </mxCell>

        <!-- Lane: Admin -->
        <mxCell id="lane_admin" value="Admin" style="swimlane;startSize=30;horizontal=0;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="pool">
          <mxGeometry x="1040" y="0" width="300" height="1720" as="geometry" />
        </mxCell>

        <!-- ===== START ===== -->
        <mxCell id="start" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="lane_user">
          <mxGeometry x="145" y="50" width="30" height="30" as="geometry" />
        </mxCell>

        <!-- Visit Landing Page -->
        <mxCell id="a1" value="Truy cập Landing Page" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lane_user">
          <mxGeometry x="85" y="110" width="180" height="45" as="geometry" />
        </mxCell>

        <!-- Decision: Has account? -->
        <mxCell id="d1" value="Đã có&#xa;tài khoản?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="lane_user">
          <mxGeometry x="110" y="185" width="130" height="70" as="geometry" />
        </mxCell>

        <!-- Register -->
        <mxCell id="a2" value="Đăng ký tài khoản&#xa;(email + password)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lane_user">
          <mxGeometry x="20" y="290" width="170" height="45" as="geometry" />
        </mxCell>

        <!-- Login -->
        <mxCell id="a3" value="Đăng nhập" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lane_user">
          <mxGeometry x="95" y="370" width="150" height="45" as="geometry" />
        </mxCell>

        <!-- System: Verify -->
        <mxCell id="s1" value="Xác thực BCrypt&#xa;Cấp JWT Token (HS256)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lane_system">
          <mxGeometry x="85" y="370" width="195" height="45" as="geometry" />
        </mxCell>

        <!-- Decision: Auth ok? -->
        <mxCell id="d2" value="Xác thực&#xa;thành công?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="lane_system">
          <mxGeometry x="110" y="445" width="140" height="70" as="geometry" />
        </mxCell>

        <!-- Error -->
        <mxCell id="s_err" value="Hiển thị lỗi&#xa;đăng nhập" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="lane_system">
          <mxGeometry x="235" y="455" width="115" height="45" as="geometry" />
        </mxCell>

        <!-- Redirect /chat -->
        <mxCell id="s2" value="Redirect → /chat&#xa;Load lịch sử phiên" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lane_system">
          <mxGeometry x="85" y="545" width="195" height="45" as="geometry" />
        </mxCell>

        <!-- Decision: What to do? -->
        <mxCell id="d3" value="Chọn&#xa;chức năng" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="lane_user">
          <mxGeometry x="105" y="545" width="140" height="70" as="geometry" />
        </mxCell>

        <!-- Action: Ask question -->
        <mxCell id="a4" value="Nhập câu hỏi&#xa;pháp luật" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lane_user">
          <mxGeometry x="30" y="660" width="150" height="45" as="geometry" />
        </mxCell>

        <!-- Action: View history -->
        <mxCell id="a5" value="Xem lịch sử&#xa;hội thoại" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lane_user">
          <mxGeometry x="30" y="1060" width="150" height="45" as="geometry" />
        </mxCell>

        <!-- Action: Compare -->
        <mxCell id="a6" value="So sánh&#xa;mô hình AI" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lane_user">
          <mxGeometry x="160" y="660" width="150" height="45" as="geometry" />
        </mxCell>

        <!-- RAG Pipeline steps -->
        <mxCell id="r1" value="Guard: Lọc ngoài domain" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lane_rag">
          <mxGeometry x="55" y="660" width="220" height="40" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="Phân loại lĩnh vực pháp luật" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lane_rag">
          <mxGeometry x="55" y="720" width="220" height="40" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="Rewrite câu hỏi" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lane_rag">
          <mxGeometry x="55" y="780" width="220" height="40" as="geometry" />
        </mxCell>
        <mxCell id="r4" value="Hybrid Search (Dense + Sparse)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lane_rag">
          <mxGeometry x="55" y="840" width="220" height="40" as="geometry" />
        </mxCell>
        <mxCell id="r5" value="Rerank (Cross-Encoder, Top-5)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lane_rag">
          <mxGeometry x="55" y="900" width="220" height="40" as="geometry" />
        </mxCell>
        <mxCell id="r6" value="Phát hiện xung đột pháp lý" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lane_rag">
          <mxGeometry x="55" y="960" width="220" height="40" as="geometry" />
        </mxCell>
        <mxCell id="r7" value="Generate: LLM sinh câu trả lời [N]&#xa;(Groq → Gemini → OpenAI)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lane_rag">
          <mxGeometry x="55" y="1020" width="220" height="50" as="geometry" />
        </mxCell>

        <!-- System: Display answer -->
        <mxCell id="s3" value="Hiển thị câu trả lời&#xa;có trích dẫn [1][2]" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lane_system">
          <mxGeometry x="85" y="1090" width="195" height="45" as="geometry" />
        </mxCell>

        <!-- User: Click citation -->
        <mxCell id="a7" value="Click [N] → Mở PDF Drawer" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lane_user">
          <mxGeometry x="30" y="1160" width="275" height="45" as="geometry" />
        </mxCell>

        <!-- System: Save session -->
        <mxCell id="s4" value="Lưu phiên hội thoại → PostgreSQL" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lane_system">
          <mxGeometry x="85" y="1160" width="195" height="45" as="geometry" />
        </mxCell>

        <!-- Decision: Continue? -->
        <mxCell id="d4" value="Hỏi tiếp&#xa;hay kết thúc?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="lane_user">
          <mxGeometry x="105" y="1240" width="140" height="70" as="geometry" />
        </mxCell>

        <!-- Logout -->
        <mxCell id="a8" value="Đăng xuất" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lane_user">
          <mxGeometry x="105" y="1360" width="150" height="45" as="geometry" />
        </mxCell>

        <!-- Admin actions -->
        <mxCell id="ad1" value="Truy cập /admin&#xa;(role=ADMIN)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lane_admin">
          <mxGeometry x="55" y="545" width="185" height="45" as="geometry" />
        </mxCell>
        <mxCell id="ad2" value="Upload / Xóa tài liệu PDF" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lane_admin">
          <mxGeometry x="55" y="620" width="185" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ad3" value="Ingest Pipeline → Qdrant" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lane_admin">
          <mxGeometry x="55" y="680" width="185" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ad4" value="Quản lý người dùng &amp; phân quyền" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lane_admin">
          <mxGeometry x="55" y="740" width="185" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ad5" value="Xem thống kê hệ thống" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lane_admin">
          <mxGeometry x="55" y="800" width="185" height="40" as="geometry" />
        </mxCell>

        <!-- END -->
        <mxCell id="end" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;double=1;" vertex="1" parent="lane_user">
          <mxGeometry x="145" y="1450" width="30" height="30" as="geometry" />
        </mxCell>

        <!-- ===== EDGES in lane_user ===== -->
        <mxCell id="e1" style="endArrow=block;endFill=1;" edge="1" source="start" target="a1" parent="lane_user"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="endArrow=block;endFill=1;" edge="1" source="a1" target="d1" parent="lane_user"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="Chưa" style="endArrow=block;endFill=1;" edge="1" source="d1" target="a2" parent="lane_user"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="Đã có" style="endArrow=block;endFill=1;" edge="1" source="d1" target="a3" parent="lane_user"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="endArrow=block;endFill=1;" edge="1" source="a2" target="a3" parent="lane_user"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_d3_ask" value="Hỏi đáp" style="endArrow=block;endFill=1;" edge="1" source="d3" target="a4" parent="lane_user"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_d3_his" value="Lịch sử" style="endArrow=block;endFill=1;" edge="1" source="d3" target="a5" parent="lane_user"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_d3_cmp" value="So sánh" style="endArrow=block;endFill=1;" edge="1" source="d3" target="a6" parent="lane_user"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_cite" style="endArrow=block;endFill=1;" edge="1" source="a7" target="d4" parent="lane_user"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_d4_cont" value="Hỏi tiếp" style="endArrow=block;endFill=1;" edge="1" source="d4" target="a4" parent="lane_user"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="50" y="1275"/><mxPoint x="50" y="682"/></Array></mxGeometry></mxCell>
        <mxCell id="e_d4_end" value="Kết thúc" style="endArrow=block;endFill=1;" edge="1" source="d4" target="a8" parent="lane_user"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_logout" style="endArrow=block;endFill=1;" edge="1" source="a8" target="end" parent="lane_user"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ===== CROSS-LANE EDGES ===== -->
        <!-- User login → System verify -->
        <mxCell id="cx1" style="endArrow=block;endFill=1;dashed=1;" edge="1" source="a3" target="s1" parent="pool"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- System verify → decision -->
        <mxCell id="cx2" style="endArrow=block;endFill=1;" edge="1" source="s1" target="d2" parent="pool"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- Auth ok → redirect -->
        <mxCell id="cx3" value="OK" style="endArrow=block;endFill=1;" edge="1" source="d2" target="s2" parent="pool"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- Redirect → chọn chức năng -->
        <mxCell id="cx4" style="endArrow=block;endFill=1;dashed=1;" edge="1" source="s2" target="d3" parent="pool"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- Ask → RAG -->
        <mxCell id="cx5" style="endArrow=block;endFill=1;dashed=1;" edge="1" source="a4" target="r1" parent="pool"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- RAG chain -->
        <mxCell id="cr1" style="endArrow=block;endFill=1;" edge="1" source="r1" target="r2" parent="pool"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="cr2" style="endArrow=block;endFill=1;" edge="1" source="r2" target="r3" parent="pool"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="cr3" style="endArrow=block;endFill=1;" edge="1" source="r3" target="r4" parent="pool"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="cr4" style="endArrow=block;endFill=1;" edge="1" source="r4" target="r5" parent="pool"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="cr5" style="endArrow=block;endFill=1;" edge="1" source="r5" target="r6" parent="pool"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="cr6" style="endArrow=block;endFill=1;" edge="1" source="r6" target="r7" parent="pool"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- RAG → System display -->
        <mxCell id="cx6" style="endArrow=block;endFill=1;dashed=1;" edge="1" source="r7" target="s3" parent="pool"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- System → save + User see citation -->
        <mxCell id="cx7" style="endArrow=block;endFill=1;dashed=1;" edge="1" source="s3" target="a7" parent="pool"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="cx8" style="endArrow=block;endFill=1;dashed=1;" edge="1" source="s3" target="s4" parent="pool"><mxGeometry relative="1" as="geometry"/></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
