<mxfile host="app.diagrams.net">
  <diagram name="So Sanh Mo Hinh AI">
    <mxGraphModel dx="1300" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="750" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- System Boundary -->
        <mxCell id="sys" value="So Sánh Mô Hình AI — Hệ thống Legal QA" style="swimlane;startSize=30;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="120" y="20" width="980" height="700" as="geometry" />
        </mxCell>

        <!-- Actor: User (left) -->
        <mxCell id="user" value="User" style="shape=mxgraph.uml.actor;whiteSpace=wrap;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="25" y="310" width="50" height="80" as="geometry" />
        </mxCell>

        <!-- External System: Groq API (right, outside boundary) -->
        <mxCell id="groq" value="Groq API" style="shape=mxgraph.uml.actor2;whiteSpace=wrap;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="1135" y="310" width="60" height="80" as="geometry" />
        </mxCell>

        <!-- ===== USE CASES ===== -->

        <!-- Main -->
        <mxCell id="uc_main" value="So sánh mô hình AI" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="sys">
          <mxGeometry x="60" y="310" width="200" height="65" as="geometry" />
        </mxCell>

        <!-- Include: Nhập câu hỏi -->
        <mxCell id="uc_input" value="Nhập câu hỏi pháp luật" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="sys">
          <mxGeometry x="60" y="140" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- Include: 3 models -->
        <mxCell id="uc_col1" value="Cột 1: Legal RAG&#xa;(Hybrid Search + LLM)" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="sys">
          <mxGeometry x="350" y="100" width="210" height="65" as="geometry" />
        </mxCell>

        <mxCell id="uc_col2" value="Cột 2: Llama 3.3 70B&#xa;(Không RAG — Vanilla)" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="sys">
          <mxGeometry x="350" y="310" width="210" height="65" as="geometry" />
        </mxCell>

        <mxCell id="uc_col3" value="Cột 3: Llama 4 Scout 17B&#xa;(Không RAG — Vanilla)" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="sys">
          <mxGeometry x="350" y="510" width="210" height="65" as="geometry" />
        </mxCell>

        <!-- Include: Gọi API song song -->
        <mxCell id="uc_api_call" value="Gọi Groq API song song&#xa;(asyncio.gather)" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="sys">
          <mxGeometry x="660" y="310" width="215" height="65" as="geometry" />
        </mxCell>

        <!-- Include: Xem kết quả -->
        <mxCell id="uc_result" value="Xem kết quả 3 cột song song" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="sys">
          <mxGeometry x="350" y="600" width="210" height="60" as="geometry" />
        </mxCell>

        <!-- ===== ACTOR EDGES ===== -->
        <mxCell id="e_user" style="endArrow=none;" edge="1" source="user" target="uc_main" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Groq API: association (không dùng include) -->
        <mxCell id="e_groq" style="endArrow=none;" edge="1" source="groq" target="uc_api_call" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== INCLUDE EDGES ===== -->
        <mxCell id="inc0" value="&lt;&lt;include&gt;&gt;" style="dashed=1;endArrow=open;endFill=0;" edge="1" source="uc_main" target="uc_input" parent="sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="inc1" value="&lt;&lt;include&gt;&gt;" style="dashed=1;endArrow=open;endFill=0;" edge="1" source="uc_main" target="uc_col1" parent="sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="inc2" value="&lt;&lt;include&gt;&gt;" style="dashed=1;endArrow=open;endFill=0;" edge="1" source="uc_main" target="uc_col2" parent="sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="inc3" value="&lt;&lt;include&gt;&gt;" style="dashed=1;endArrow=open;endFill=0;" edge="1" source="uc_main" target="uc_col3" parent="sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 3 cols → Gọi API -->
        <mxCell id="inc4" value="&lt;&lt;include&gt;&gt;" style="dashed=1;endArrow=open;endFill=0;" edge="1" source="uc_col1" target="uc_api_call" parent="sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="inc5" value="&lt;&lt;include&gt;&gt;" style="dashed=1;endArrow=open;endFill=0;" edge="1" source="uc_col2" target="uc_api_call" parent="sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="inc6" value="&lt;&lt;include&gt;&gt;" style="dashed=1;endArrow=open;endFill=0;" edge="1" source="uc_col3" target="uc_api_call" parent="sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Xem kết quả là include (luôn hiển thị) -->
        <mxCell id="inc7" value="&lt;&lt;include&gt;&gt;" style="dashed=1;endArrow=open;endFill=0;" edge="1" source="uc_main" target="uc_result" parent="sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
