<mxfile host="app.diagrams.net">
  <diagram name="Multi-turn Conversation">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- System Boundary -->
        <mxCell id="sys" value="Hỏi Tiếp / Multi-turn Conversation — Hệ thống Legal QA" style="swimlane;startSize=30;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="120" y="20" width="1000" height="660" as="geometry" />
        </mxCell>

        <!-- Actor -->
        <mxCell id="user" value="User" style="shape=mxgraph.uml.actor;whiteSpace=wrap;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="25" y="280" width="50" height="80" as="geometry" />
        </mxCell>

        <!-- ===== MAIN USE CASES ===== -->
        <mxCell id="uc_followup" value="Hỏi tiếp / Yêu cầu&#xa;giải thích thêm" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="sys">
          <mxGeometry x="70" y="280" width="210" height="65" as="geometry" />
        </mxCell>

        <mxCell id="uc_new_session" value="Bắt đầu phiên hội thoại mới" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="sys">
          <mxGeometry x="70" y="490" width="210" height="60" as="geometry" />
        </mxCell>

        <!-- ===== INCLUDE USE CASES ===== -->
        <mxCell id="uc_history" value="Đọc lịch sử hội thoại&#xa;(chat_history)" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="sys">
          <mxGeometry x="380" y="140" width="210" height="65" as="geometry" />
        </mxCell>

        <mxCell id="uc_domain_inherit" value="Kế thừa domain từ&#xa;câu hỏi trước" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="sys">
          <mxGeometry x="380" y="270" width="210" height="65" as="geometry" />
        </mxCell>

        <mxCell id="uc_rag" value="Gọi lại RAG Pipeline&#xa;với context đầy đủ" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="sys">
          <mxGeometry x="380" y="400" width="210" height="65" as="geometry" />
        </mxCell>

        <!-- ===== EXTEND USE CASES ===== -->
        <mxCell id="uc_clear" value="Xóa context hội thoại&#xa;(Reset session)" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="sys">
          <mxGeometry x="700" y="470" width="210" height="65" as="geometry" />
        </mxCell>

        <mxCell id="uc_save" value="Lưu phiên hội thoại&#xa;vào DB" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="sys">
          <mxGeometry x="700" y="350" width="200" height="65" as="geometry" />
        </mxCell>

        <mxCell id="uc_answer" value="Sinh câu trả lời&#xa;có ngữ cảnh trước" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="sys">
          <mxGeometry x="700" y="220" width="200" height="65" as="geometry" />
        </mxCell>

        <!-- ===== ACTOR EDGES ===== -->
        <mxCell id="e1" style="endArrow=none;" edge="1" source="user" target="uc_followup" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="endArrow=none;" edge="1" source="user" target="uc_new_session" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== INCLUDE EDGES ===== -->
        <mxCell id="inc1" value="&lt;&lt;include&gt;&gt;" style="dashed=1;endArrow=open;endFill=0;" edge="1" source="uc_followup" target="uc_history" parent="sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="inc2" value="&lt;&lt;include&gt;&gt;" style="dashed=1;endArrow=open;endFill=0;" edge="1" source="uc_followup" target="uc_domain_inherit" parent="sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="inc3" value="&lt;&lt;include&gt;&gt;" style="dashed=1;endArrow=open;endFill=0;" edge="1" source="uc_followup" target="uc_rag" parent="sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="inc4" value="&lt;&lt;include&gt;&gt;" style="dashed=1;endArrow=open;endFill=0;" edge="1" source="uc_rag" target="uc_answer" parent="sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="inc5" value="&lt;&lt;include&gt;&gt;" style="dashed=1;endArrow=open;endFill=0;" edge="1" source="uc_rag" target="uc_save" parent="sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== EXTEND EDGES ===== -->
        <mxCell id="ext1" value="&lt;&lt;extend&gt;&gt;" style="dashed=1;endArrow=open;endFill=0;" edge="1" source="uc_new_session" target="uc_clear" parent="sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
