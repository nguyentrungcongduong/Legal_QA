<mxfile host="app.diagrams.net">
  <diagram name="Admin Use Case">
    <mxGraphModel dx="1300" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- System Boundary -->
        <mxCell id="sys" value="Quản Trị Hệ Thống (Admin) — Legal QA RAG" style="swimlane;startSize=30;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="120" y="20" width="1080" height="740" as="geometry" />
        </mxCell>

        <!-- Actor: Admin (left) -->
        <mxCell id="admin" value="Admin" style="shape=mxgraph.uml.actor;whiteSpace=wrap;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="20" y="330" width="55" height="80" as="geometry" />
        </mxCell>

        <!-- External System: Qdrant Vector DB -->
        <mxCell id="qdrant" value="Qdrant&#xa;Vector DB" style="shape=mxgraph.uml.actor2;whiteSpace=wrap;html=1;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1230" y="150" width="60" height="80" as="geometry" />
        </mxCell>

        <!-- External System: PostgreSQL -->
        <mxCell id="postgres" value="PostgreSQL" style="shape=mxgraph.uml.actor2;whiteSpace=wrap;html=1;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1230" y="420" width="60" height="80" as="geometry" />
        </mxCell>

        <!-- ===== MAIN USE CASES ===== -->
        <mxCell id="uc_doc" value="Quản lý tài liệu pháp luật" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="sys">
          <mxGeometry x="60" y="140" width="220" height="65" as="geometry" />
        </mxCell>

        <mxCell id="uc_stats" value="Xem thống kê hệ thống" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="sys">
          <mxGeometry x="60" y="360" width="220" height="65" as="geometry" />
        </mxCell>

        <mxCell id="uc_users" value="Quản lý người dùng" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="sys">
          <mxGeometry x="60" y="560" width="220" height="65" as="geometry" />
        </mxCell>

        <!-- ===== INCLUDE: Quản lý tài liệu ===== -->
        <mxCell id="uc_upload" value="Upload tài liệu PDF mới" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="sys">
          <mxGeometry x="370" y="60" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="uc_ingest" value="Kích hoạt Ingest Pipeline&#xa;(Chunking + Embedding)" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="sys">
          <mxGeometry x="680" y="60" width="220" height="65" as="geometry" />
        </mxCell>

        <mxCell id="uc_delete_doc" value="Xóa tài liệu&#xa;khỏi hệ thống" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="sys">
          <mxGeometry x="370" y="180" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="uc_watcher" value="File Watcher&#xa;(Auto-ingest khi có file mới)" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="sys">
          <mxGeometry x="370" y="300" width="210" height="60" as="geometry" />
        </mxCell>

        <!-- ===== INCLUDE: Thống kê ===== -->
        <mxCell id="uc_stat_users" value="Xem số lượng người dùng" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="sys">
          <mxGeometry x="370" y="400" width="210" height="55" as="geometry" />
        </mxCell>

        <mxCell id="uc_stat_docs" value="Xem số tài liệu &amp; chunks" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="sys">
          <mxGeometry x="370" y="480" width="210" height="55" as="geometry" />
        </mxCell>

        <mxCell id="uc_stat_queries" value="Xem số lượng câu hỏi đã xử lý" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="sys">
          <mxGeometry x="680" y="440" width="220" height="55" as="geometry" />
        </mxCell>

        <!-- ===== INCLUDE: Quản lý users ===== -->
        <mxCell id="uc_list_users" value="Xem danh sách người dùng" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="sys">
          <mxGeometry x="370" y="580" width="210" height="55" as="geometry" />
        </mxCell>

        <mxCell id="uc_role" value="Phân quyền người dùng&#xa;(User / Admin)" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="sys">
          <mxGeometry x="370" y="660" width="210" height="55" as="geometry" />
        </mxCell>

        <!-- ===== ACTOR EDGES ===== -->
        <mxCell id="e_a1" style="endArrow=none;" edge="1" source="admin" target="uc_doc" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_a2" style="endArrow=none;" edge="1" source="admin" target="uc_stats" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_a3" style="endArrow=none;" edge="1" source="admin" target="uc_users" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- External system associations -->
        <mxCell id="e_q1" style="endArrow=none;" edge="1" source="qdrant" target="uc_ingest" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_p1" style="endArrow=none;" edge="1" source="postgres" target="uc_stat_queries" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== INCLUDE: Doc management ===== -->
        <mxCell id="inc1" value="&lt;&lt;include&gt;&gt;" style="dashed=1;endArrow=open;endFill=0;" edge="1" source="uc_doc" target="uc_upload" parent="sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="inc2" value="&lt;&lt;include&gt;&gt;" style="dashed=1;endArrow=open;endFill=0;" edge="1" source="uc_doc" target="uc_delete_doc" parent="sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="inc3" value="&lt;&lt;include&gt;&gt;" style="dashed=1;endArrow=open;endFill=0;" edge="1" source="uc_doc" target="uc_watcher" parent="sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="inc4" value="&lt;&lt;include&gt;&gt;" style="dashed=1;endArrow=open;endFill=0;" edge="1" source="uc_upload" target="uc_ingest" parent="sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== INCLUDE: Stats ===== -->
        <mxCell id="inc5" value="&lt;&lt;include&gt;&gt;" style="dashed=1;endArrow=open;endFill=0;" edge="1" source="uc_stats" target="uc_stat_users" parent="sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="inc6" value="&lt;&lt;include&gt;&gt;" style="dashed=1;endArrow=open;endFill=0;" edge="1" source="uc_stats" target="uc_stat_docs" parent="sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="inc7" value="&lt;&lt;include&gt;&gt;" style="dashed=1;endArrow=open;endFill=0;" edge="1" source="uc_stats" target="uc_stat_queries" parent="sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== INCLUDE: Users ===== -->
        <mxCell id="inc8" value="&lt;&lt;include&gt;&gt;" style="dashed=1;endArrow=open;endFill=0;" edge="1" source="uc_users" target="uc_list_users" parent="sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="inc9" value="&lt;&lt;include&gt;&gt;" style="dashed=1;endArrow=open;endFill=0;" edge="1" source="uc_users" target="uc_role" parent="sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
