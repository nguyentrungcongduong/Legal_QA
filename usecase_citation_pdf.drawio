<mxfile host="app.diagrams.net">
  <diagram name="Trich Dan PDF">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="750" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- System Boundary -->
        <mxCell id="sys" value="Xem Trích Dẫn &amp; Tài Liệu PDF Gốc — Hệ thống Legal QA" style="swimlane;startSize=30;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="120" y="20" width="1000" height="680" as="geometry" />
        </mxCell>

        <!-- Actor -->
        <mxCell id="user" value="User" style="shape=mxgraph.uml.actor;whiteSpace=wrap;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="25" y="300" width="50" height="80" as="geometry" />
        </mxCell>

        <!-- ===== USE CASES ===== -->

        <!-- Main: Click citation marker -->
        <mxCell id="uc_click" value="Click số trích dẫn [N]&#xa;trong câu trả lời" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="sys">
          <mxGeometry x="80" y="190" width="210" height="65" as="geometry" />
        </mxCell>

        <!-- Main: Xem trích dẫn -->
        <mxCell id="uc_cite" value="Xem danh sách trích dẫn nguồn" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="sys">
          <mxGeometry x="80" y="390" width="210" height="65" as="geometry" />
        </mxCell>

        <!-- Includes từ Xem trích dẫn -->
        <mxCell id="uc_meta" value="Xem metadata văn bản&#xa;(Tên NĐ, Điều, Khoản, Trang)" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="sys">
          <mxGeometry x="390" y="290" width="220" height="65" as="geometry" />
        </mxCell>

        <mxCell id="uc_score" value="Xem điểm liên quan&#xa;(Relevance Score)" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="sys">
          <mxGeometry x="390" y="430" width="210" height="65" as="geometry" />
        </mxCell>

        <!-- Extend: Xem PDF -->
        <mxCell id="uc_pdf" value="Mở PDF Drawer" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="sys">
          <mxGeometry x="390" y="130" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="uc_navigate" value="Điều hướng đến trang&#xa;chứa đoạn trích dẫn" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="sys">
          <mxGeometry x="680" y="80" width="220" height="65" as="geometry" />
        </mxCell>

        <mxCell id="uc_render" value="Hiển thị nội dung PDF&#xa;(PDF Viewer)" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="sys">
          <mxGeometry x="680" y="200" width="210" height="65" as="geometry" />
        </mxCell>

        <mxCell id="uc_highlight" value="Highlight đoạn văn bản&#xa;liên quan trong PDF" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="sys">
          <mxGeometry x="680" y="320" width="215" height="65" as="geometry" />
        </mxCell>

        <!-- ===== ACTOR EDGES ===== -->
        <mxCell id="e_u1" style="endArrow=none;" edge="1" source="user" target="uc_click" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_u2" style="endArrow=none;" edge="1" source="user" target="uc_cite" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== INCLUDE EDGES ===== -->
        <!-- Click [N] include Mở PDF Drawer -->
        <mxCell id="inc1" value="&lt;&lt;include&gt;&gt;" style="dashed=1;endArrow=open;endFill=0;" edge="1" source="uc_click" target="uc_pdf" parent="sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Xem trích dẫn include metadata + score -->
        <mxCell id="inc2" value="&lt;&lt;include&gt;&gt;" style="dashed=1;endArrow=open;endFill=0;" edge="1" source="uc_cite" target="uc_meta" parent="sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="inc3" value="&lt;&lt;include&gt;&gt;" style="dashed=1;endArrow=open;endFill=0;" edge="1" source="uc_cite" target="uc_score" parent="sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Mở PDF include render + navigate -->
        <mxCell id="inc4" value="&lt;&lt;include&gt;&gt;" style="dashed=1;endArrow=open;endFill=0;" edge="1" source="uc_pdf" target="uc_navigate" parent="sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="inc5" value="&lt;&lt;include&gt;&gt;" style="dashed=1;endArrow=open;endFill=0;" edge="1" source="uc_pdf" target="uc_render" parent="sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== EXTEND EDGES ===== -->
        <!-- Highlight là optional -->
        <mxCell id="ext1" value="&lt;&lt;extend&gt;&gt;" style="dashed=1;endArrow=open;endFill=0;" edge="1" source="uc_highlight" target="uc_render" parent="sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Xem trích dẫn extend mở PDF -->
        <mxCell id="ext2" value="&lt;&lt;extend&gt;&gt;" style="dashed=1;endArrow=open;endFill=0;" edge="1" source="uc_cite" target="uc_pdf" parent="sys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
